# Copy to .env and edit. .env is git-ignored.

# --- Airflow ---
AIRFLOW_UID=50000                 # Linux: set to the output of `id -u`
AIRFLOW_FERNET_KEY=               # optional: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_WEBSERVER_SECRET_KEY=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# --- Warehouse (from your laptop: localhost:5433) ---
WAREHOUSE_USER=dataflow
WAREHOUSE_PASSWORD=dataflow
WAREHOUSE_DB=warehouse
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433

# --- Source OLTP DB (from your laptop: localhost:5434) ---
SOURCE_DB_USER=shop
SOURCE_DB_PASSWORD=shop
SOURCE_DB_NAME=shop
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5434

# --- dbt (from your laptop) ---
DBT_HOST=localhost
DBT_PORT=5433
DBT_PROFILES_DIR=./dbt_dataflow

# --- Files + mock payments API ---
DATA_DIR=./data/generated
PAYMENTS_API_URL=http://localhost:8000
API_FAILURE_RATE=0.1              # share of API calls that randomly fail (tests retries)

# --- Alerts (leave empty to disable) ---
SLACK_WEBHOOK_URL=
ALERT_EMAIL=
